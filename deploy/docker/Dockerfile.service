# Multi-stage Dockerfile for ShopSphere .NET microservices
ARG DOTNET_VERSION=10.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}-alpine AS build
WORKDIR /src

# Copy central package management and build props
COPY Directory.Build.props Directory.Packages.props ./

# Copy BuildingBlocks
COPY src/BuildingBlocks/ src/BuildingBlocks/

# Arguments for target service
ARG SERVICE_DIR=src/Services/Catalog
ARG PROJECT_PATH=src/Services/Catalog/Catalog.Api/Catalog.Api.csproj

# Copy service source code
COPY ${SERVICE_DIR}/ ${SERVICE_DIR}/

# Restore and publish
RUN dotnet restore ${PROJECT_PATH}
RUN dotnet publish ${PROJECT_PATH} -c Release -o /app/publish --no-restore

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION}-alpine AS runtime
WORKDIR /app

USER $APP_UID

COPY --from=build /app/publish .

ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080

ARG DLL_NAME=Catalog.Api.dll
ENV TARGET_DLL=${DLL_NAME}

ENTRYPOINT exec dotnet "$TARGET_DLL"
