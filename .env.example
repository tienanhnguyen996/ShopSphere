# GitHub Personal Access Token (for gh CLI and GitHub MCP)
# Scopes: repo, read:org
# Create: https://github.com/settings/tokens/new
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE

# Notion Integration Token (for Notion MCP)
# Create: https://www.notion.so/my-integrations
# Required if using Notion for docs/specs
NOTION_TOKEN=secret_YOUR_TOKEN_HERE

# SQL Server connection (local dev)
SQLSERVER_CONNECTION_STRING=Server=localhost,1433;User Id=sa;Password=DevPassword123!;TrustServerCertificate=True

# RabbitMQ connection (local dev)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Redis connection (local dev)
REDIS_HOST=localhost:6379
