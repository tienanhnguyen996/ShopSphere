{
  "openapi": "3.0.1",
  "info": {
    "title": "ShopSphere Payment Service API",
    "description": "Microservice managing payment processing, mock provider interactions, timeout handling (PaymentUnknown), and webhooks.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/payment/webhooks/mock-provider": {
      "post": {
        "tags": [
          "Payment"
        ],
        "summary": "Receives provider webhook callbacks with HMAC-SHA256 signature verification",
        "operationId": "ProviderWebhook",
        "parameters": [
          {
            "name": "X-Payment-Signature",
            "in": "header",
            "required": true,
            "description": "HMAC-SHA256 signature calculated with webhook secret.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderWebhookPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/payment/attempts/{id}": {
      "get": {
        "tags": [
          "Payment"
        ],
        "summary": "Retrieve details of a payment attempt by identifier",
        "operationId": "GetPaymentAttemptById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentAttemptResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/payment/orders/{orderId}": {
      "get": {
        "tags": [
          "Payment"
        ],
        "summary": "Retrieve the latest payment attempt for an order",
        "operationId": "GetPaymentAttemptByOrderId",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentAttemptResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderWebhookPayload": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string"
          },
          "eventType": {
            "type": "string"
          },
          "paymentAttemptId": {
            "type": "string",
            "format": "uuid"
          },
          "providerTransactionId": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "eventId",
          "eventType",
          "paymentAttemptId",
          "status"
        ],
        "additionalProperties": false
      },
      "PaymentAttemptResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string",
            "nullable": true
          },
          "paymentMethod": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "providerTransactionId": {
            "type": "string",
            "nullable": true
          },
          "failureReason": {
            "type": "string",
            "nullable": true
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAtUtc": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}