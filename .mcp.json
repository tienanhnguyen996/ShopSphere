{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@0.5.0"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-notion@0.2.0"],
      "env": {
        "NOTION_API_KEY": "${NOTION_TOKEN}"
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@context7/mcp-server@latest"]
    },
    "microsoft-learn": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "mcp/microsoft-learn:0.1.0"
      ]
    },
    "terraform": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${PWD}/deploy/terraform:/workspace",
        "mcp/terraform:0.2.0"
      ]
    },
    "postman": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postman@0.1.0"],
      "env": {
        "POSTMAN_API_KEY": "${POSTMAN_API_KEY}",
        "POSTMAN_WORKSPACE_NAME": "${POSTMAN_WORKSPACE_NAME}"
      }
    }
  }
}
